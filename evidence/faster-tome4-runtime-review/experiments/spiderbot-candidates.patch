+    for i = 1, settings.count do bots[i] = bot(i, settings.shared and 1 or ((i - 1) % 8 + 1)) end
+    local store = {bots = bots}
+    local map = setmetatable({}, {__call = function(_, x, y) record("map", x, y); return byX[x] end})
+    function map:particleEmitter(x, y, radius, kind, params, shader, depth) record("particle", x, y, kind, params.tx, params.ty, depth) end
+    function map:removeParticleEmitter(p) record("remove", p) end
+    local e = env{Map = {ACTOR = 100}, game = {level = {map = map}}, pairs = orderedPairs,
+        ripairs = function(t) local i = #t + 1; return function() i = i - 1; if i > 0 then return i, t[i] end end end,
+        ipairs = function(t)
