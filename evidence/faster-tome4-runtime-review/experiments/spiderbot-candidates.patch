+-- Deterministic actor-key iteration allows exact cross-world RNG/callback traces.
+-- Selection still uses the engine's original pairs traversal, insertion and sort.
+local function orderedPairs(t)
+    local keys = {}; local actorKeys = false
+    for k in pairs(t) do keys[#keys + 1] = k; if type(k) == "table" and k.uid then actorKeys = true end end
+    if not actorKeys then return pairs(t) end
+    table.sort(keys, function(a, b) return a.uid < b.uid end)
+    local i = 0
+    return function() i = i + 1; local k = keys[i]; if k then return k, t[k] end end
+end
