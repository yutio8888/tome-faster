+        function a:canBe(what) record("canBe", self, what); return true end
+        function a:attr(what) record("attr", self, what); return false end
+        function a:setEffect(kind, dur, params) record("effect", self, kind, dur, params.apply_power) end
+        targetList[i], byX[i] = a, a
+    end
+    local function bot(i, x)
